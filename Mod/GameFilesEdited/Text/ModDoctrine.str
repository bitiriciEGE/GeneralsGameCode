// MOD: Doctrine texts. Merged on top of the vanilla generals.csf by the Mod Builder (item ModLanguage).

//------------------------------------------------------------------------------
// USA
//------------------------------------------------------------------------------
UPGRADE:ModDoctrineUSANetwork
US: "Network Warfare Doctrine"
END

CONTROLBAR:ModUpgradeDoctrineUSANetwork
US: "&Network Warfare Doctrine"
END

CONTROLBAR:ModTooltipDoctrineUSANetwork
US: "Permanent choice, locks out Rapid Deployment. Grants the Spy Drone general power. Aircraft cost 20% less while you own a Strategy Center."
END

UPGRADE:ModDoctrineUSARapid
US: "Rapid Deployment Doctrine"
END

CONTROLBAR:ModUpgradeDoctrineUSARapid
US: "Rapid D&eployment Doctrine"
END

CONTROLBAR:ModTooltipDoctrineUSARapid
US: "Permanent choice, locks out Network Warfare. Grants the Paradrop general power. Vehicles cost 15% less while you own a Strategy Center."
END

